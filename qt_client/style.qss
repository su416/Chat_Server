/* ChatClient 全局样式 */

QMainWindow {
    background-color: #f0f2f5;
}

QGroupBox {
    font-weight: bold;
    border: 1px solid #d0d0d0;
    border-radius: 6px;
    margin-top: 10px;
    padding-top: 10px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 5px;
}

QListView {
    border: 1px solid #dcdcdc;
    border-radius: 4px;
    background-color: #ffffff;
    padding: 4px;
}

QListView::item {
    padding: 6px 8px;
    border-bottom: 1px solid #f0f0f0;
}

QListView::item:hover {
    background-color: #e8f4fd;
}

QListView::item:selected {
    background-color: #cce5ff;
    color: #333;
}

QPushButton {
    background-color: #07c160;
    color: white;
    border: none;
    border-radius: 4px;
    padding: 8px 18px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #06ad56;
}

QPushButton:pressed {
    background-color: #059048;
}

QPushButton#logoutButton {
    background-color: #f56c6c;
}

QPushButton#logoutButton:hover {
    background-color: #e04545;
}

QTextEdit {
    border: 1px solid #dcdcdc;
    border-radius: 4px;
    background-color: #ffffff;
    padding: 6px;
}

QLineEdit {
    border: 1px solid #dcdcdc;
    border-radius: 4px;
    padding: 6px 10px;
    background-color: #ffffff;
}

QLineEdit:focus {
    border-color: #07c160;
}

QLabel {
    color: #333;
}
